[Unit]
Description=Home Library web app socket
Documentation=file:/usr/share/doc/home-library/README.Debian

[Socket]
# The web server connects here; only root, the app and group www-data (nginx
# and Apache run as www-data on Debian and Ubuntu) may open it.
ListenStream=/run/home-library/home-library.sock
SocketUser=home-library
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
