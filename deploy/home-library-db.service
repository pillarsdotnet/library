# Moves the SQLite database to whichever node is becoming active.
#
# Before=home-library.service is load-bearing in BOTH directions:
#   * on boot it runs first, so the right database is in place before the app opens it;
#   * on shutdown it runs LAST, after systemd has already stopped the app, so the
#     database is quiescent and this unit never has to stop the app itself.
#
# That last point is the whole reason this is a separate unit. An earlier single-unit
# design was ordered After=home-library.service and called `systemctl stop
# home-library` from its own ExecStop — which deadlocks, because systemd will not run
# that stop job until the ExecStop it is already waiting on returns. It hung until
# TimeoutStopSec every time, leaving the handoff half-done and the app down.
# Never call systemctl against the local app from inside a hook; express the
# ordering as a dependency and let systemd sequence it.
#
# Install on BOTH nodes, identically. PREFERRED (default: homelab) decides which one
# reclaims the service when it boots; the other comes up active only if it already
# owns the database, i.e. the preferred node handed over and has not returned.
# Install:
#   cp deploy/failover.sh /usr/local/sbin/home-library-failover && chmod 755 "$_"
#   cp deploy/home-library-db.service deploy/home-library-vip.service /etc/systemd/system/
#   systemctl edit home-library-db     # Environment=PEER=... and VIP=...
#   systemctl edit home-library-vip    # the same two
#   systemctl daemon-reload
#   systemctl enable home-library-db home-library-vip
#
#   # REQUIRED on BOTH nodes. Two separate jobs:
#   #  * Requires= — ordering (Before=) is not a requirement, so without it the app
#   #    starts anyway after db-claim deliberately refused, serves the stale local
#   #    copy, and lets the vip unit advertise it as authoritative.
#   #  * ConditionPathExists= — lets a standby boot SKIP the app cleanly instead of
#   #    failing. db-claim creates the flag only on the node that should be active.
#   mkdir -p /etc/systemd/system/home-library.service.d
#   printf '[Unit]\nRequires=home-library-db.service\nConditionPathExists=/run/home-library-active\n' \
#       > /etc/systemd/system/home-library.service.d/failover.conf
#
#   # Recommended on BOTH nodes: an intentional stop otherwise leaves the unit
#   # failed, because `docker run` exits non-zero when its container is killed.
#   printf '[Service]\nSuccessExitStatus=143 137\n' \
#       > /etc/systemd/system/home-library.service.d/exitstatus.conf

[Unit]
Description=Home Library database handoff
# tailscaled too: the peer is reached over the tailnet, and being ordered only
# After=network-online.target left the peer unreachable at boot. The script also
# retries, because "tailscaled is active" is not "the tailnet is connected".
After=network-online.target docker.service tailscaled.service
Wants=network-online.target
Requires=docker.service
Before=home-library.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A handoff copies the whole database over ssh and waits for a health check at the
# far end. Too short and shutdown kills it mid-copy.
TimeoutStartSec=600
TimeoutStopSec=600
ExecStart=/usr/local/sbin/home-library-failover db-claim
ExecStop=/usr/local/sbin/home-library-failover db-release

[Install]
WantedBy=multi-user.target
