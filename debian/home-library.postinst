#!/bin/sh
set -e

ENV=/etc/home-library/home-library.env
SECRET=/etc/home-library/secret.env
SNIPPET=snippets/home-library.conf

if [ "$1" = configure ]; then
    # The user has to exist before the files below can belong to its group,
    # and the debhelper section further down starts the service. Creating it
    # twice is harmless.
    systemd-sysusers home-library.conf

    # The settings file holds secrets: root writes it, the service reads it.
    if ! dpkg-statoverride --list "$ENV" >/dev/null; then
        dpkg-statoverride --update --add root home-library 0640 "$ENV"
    fi

    # A session secret that survives restarts, so a restart does not sign
    # everybody out. Written once and never touched again, and not a conffile:
    # home-library.env is the place to set your own.
    if [ ! -e "$SECRET" ]; then
        umask 027
        printf '# Generated by the home-library package. Delete to regenerate.\nSESSION_SECRET=%s\n' \
            "$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')" > "$SECRET"
        chgrp home-library "$SECRET"
    fi

    # Apache: the conf itself is enabled by the debhelper section below.
    if [ -e /usr/share/apache2/apache2-maintscript-helper ]; then
        . /usr/share/apache2/apache2-maintscript-helper
        for mod in proxy proxy_http headers; do
            apache2_invoke enmod "$mod" || true
        done
    fi

    # nginx cannot have a location added to a site from outside it, so say
    # how, or reload if a site already includes the snippet.
    if [ -d /etc/nginx ]; then
        if grep -rqsF "$SNIPPET" /etc/nginx/sites-enabled /etc/nginx/conf.d; then
            if [ -d /run/systemd/system ] && systemctl -q is-active nginx.service; then
                deb-systemd-invoke reload nginx.service || true
            fi
        else
            echo "home-library: to serve it with nginx, add this line inside a server { } block"
            echo "home-library: of your site, then reload nginx:"
            echo "home-library:     include $SNIPPET;"
        fi
    fi
fi

#DEBHELPER#

exit 0
