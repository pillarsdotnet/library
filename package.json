{
  "name": "home-library",
  "version": "5.4.0",
  "description": "Catalogue books in a private library with ISBN scanning, location tracking, and SQLite storage.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"public/**/*.css\" --fix",
    "test": "node --test",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:deps": "node check-deps.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "better-sqlite3": "^13.0.3",
    "cropperjs": "^1.6.2",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "html5-qrcode": "^2.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^15.14.0",
    "puppeteer-core": "^25.3.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "overrides": {
    "@ericblade/quagga2": {
      "sharp": "$sharp"
    },
    "braces": "git+https://github.com/pillarsdotnet/braces.git#40748d305d656d5bcd323439346298b9ff24a771"
  }
}
