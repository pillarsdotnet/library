# Settings for the home-library service, read by systemd (KEY=value, no
# quotes needed, no shell expansion). Uncomment and set what you need, then:
#   sudo systemctl restart home-library.service
#
# The service already sets, and this file may override:
#   DB_PATH=/var/lib/home-library/library.db
#   BASE_PATH=/library        the URL path nginx and Apache forward
#   TRUST_PROXY=true          the web server in front sets X-Forwarded-Proto
# SESSION_SECRET is generated on install, in /etc/home-library/secret.env.
# Set it here instead to choose your own.

# Scheme and host the app is reached at, for sign-in redirects and emailed
# links. Taken from each request when unset.
#PUBLIC_ORIGIN=https://example.org

# Sign-in with Google. Setting both turns sign-in on; without them anyone who
# can reach the site can edit the library.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#OAUTH_REDIRECT_URI=
#SESSION_IDLE_DAYS=10
#AUTH_ALLOWED_FILE=/var/lib/home-library/allowed-emails.txt

# Mail sent when a new library is created. Setting user and password turns it
# on.
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587

# ISBN lookups.
#GOOGLE_BOOKS_API_KEY=
#LOOKUP_TTL_DAYS=30
#LOOKUP_NEGATIVE_TTL_HOURS=24

# Contributing back to Open Library.
#OPENLIBRARY_ACCESS_KEY=
#OPENLIBRARY_SECRET_KEY=
#OPENLIBRARY_ALLOW_IMPORT=
#OPENLIBRARY_SOURCE_PREFIX=pillarsdotnet_library
